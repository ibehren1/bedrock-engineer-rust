{
  "name": "bedrock-engineer",
  "productName": "Bedrock Engineer",
  "version": "2026.1001.34",
  "browserslist": [
    "chrome >= 105",
    "safari >= 15"
  ],
  "description": "Autonomous software development agent apps using Amazon Bedrock, capable of customize to create/edit files, execute commands, search the web, use knowledge base, use multi-agents, generative images and more.",
  "homepage": "https://github.com/aws-samples/bedrock-engineer",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "lint:fix": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watchAll  --config jest.config.js",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dev": "tauri dev",
    "build": "npm run typecheck && tauri build",
    "build:mac": "tauri build --target universal-apple-darwin",
    "build:win": "tauri build --bundles nsis",
    "build:linux": "tauri build --bundles appimage,deb",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "tauri": "tauri",
    "sign:mac": "codesign --force --deep --sign - \"/Applications/$(node -p \"require('./package.json').productName\").app\"",
    "notices": "sh scripts/notices/generate.sh",
    "prepare": "sh scripts/install-git-hooks.sh"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent-runtime": "^3.995.0",
    "@aws-sdk/client-bedrock-runtime": "^3.995.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codesandbox/sandpack-react": "2.18.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@headlessui/react": "^2.2.0",
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/logos": "^1.2.13",
    "@iconify-json/lucide": "^1.2.126",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.93",
    "@iconify-json/tabler": "^1.2.38",
    "@monaco-editor/react": "^4.6.0",
    "@reactour/tour": "3.7.0",
    "@tauri-apps/api": "2.12.0",
    "@tshepomgaga/aws-sfn-graph": "0.0.6",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "buffer": "^6.0.3",
    "chart.js": "^4.4.8",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^4.19.1",
    "flowbite-react": "0.10.1",
    "framer-motion": "11.3.29",
    "html-to-docx": "^1.8.0",
    "i18next": "23.15.0",
    "jszip": "^3.10.1",
    "lottie-react": "2.4.0",
    "mermaid": "^11.4.0",
    "monaco-editor": "0.56.0",
    "react-chartjs-2": "^5.3.0",
    "react-cmdk": "1.3.9",
    "react-drawio": "^1.0.3",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "15.0.1",
    "react-icons": "^5.7.0",
    "react-markdown": "9.0.1",
    "react-router": "7.18.3",
    "react-router-dom": "7.18.3",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "vite-plugin-svgr": "4.3.0",
    "zod": "^3.24.2"
  },
  "overrides": {
    "dompurify": "^3.4.16",
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@2": "^2.1.7",
    "browserslist": "^4.28.8",
    "postcss-selector-parser": "^6.1.4",
    "image-size": "^2.0.3"
  },
  "devDependencies": {
    "@smithy/types": "^4.17.2",
    "@tauri-apps/cli": "2.12.0",
    "@types/jest": "29.5.12",
    "@types/node": "^24.13.3",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "^10.5.4",
    "eslint": "8.57.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "jest": "29.7.0",
    "postcss": "^8.5.26",
    "prettier": "3.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.10",
    "ts-jest": "^29.4.12",
    "typescript": "5.9.3",
    "vite": "^6.4.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.60.1",
    "@rollup/rollup-win32-x64-msvc": "^4.60.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    }
  }
}
