{
  "name": "bedrock-engineer",
  "productName": "Bedrock Engineer",
  "version": "2026.1105.1",
  "browserslist": [
    "chrome >= 105",
    "safari >= 15"
  ],
  "description": "Autonomous software development agent apps using Amazon Bedrock, capable of customize to create/edit files, execute commands, search the web, use knowledge base, use multi-agents, generative images and more.",
  "homepage": "https://github.com/aws-samples/bedrock-engineer",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest --config jest.config.js && node --test \"scripts/release/*.test.mjs\"",
    "test:watch": "jest --watchAll  --config jest.config.js",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dev": "tauri dev",
    "build": "npm run typecheck && tauri build",
    "build:mac": "tauri build --target universal-apple-darwin",
    "build:win": "tauri build --bundles nsis",
    "build:linux": "tauri build --bundles appimage,deb",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "tauri": "tauri",
    "sign:mac": "codesign --force --deep --sign - \"/Applications/$(node -p \"require('./package.json').productName\").app\"",
    "notices": "sh scripts/notices/generate.sh",
    "prepare": "sh scripts/install-git-hooks.sh"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1154.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1154.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codesandbox/sandpack-react": "2.20.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/logos": "^1.2.17",
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.100",
    "@iconify-json/tabler": "^1.2.42",
    "@monaco-editor/react": "^4.7.0",
    "@reactour/tour": "3.8.0",
    "@tauri-apps/api": "2.12.4",
    "@tshepomgaga/aws-sfn-graph": "0.0.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "buffer": "^6.0.3",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "docx-preview": "0.4.1",
    "emoji-picker-react": "^5.1.4",
    "flowbite": "2.3.0",
    "flowbite-react": "^0.12.17",
    "framer-motion": "^14.9.1",
    "html-to-docx": "^1.8.0",
    "i18next": "^26.7.1",
    "jszip": "^3.10.2",
    "lottie-react": "^3.1.2",
    "mermaid": "^12.3.0",
    "monaco-editor": "0.57.0",
    "pdfjs-dist": "6.4.299",
    "react-chartjs-2": "^5.3.1",
    "react-cmdk": "1.3.9",
    "react-drawio": "^1.0.7",
    "react-hot-toast": "^2.6.1",
    "react-i18next": "^17.1.12",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.6.7"
  },
  "overrides": {
    "dompurify": "^3.4.16",
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@2": "^2.1.7",
    "browserslist": "^4.28.8",
    "postcss-selector-parser": "^7.1.6",
    "image-size": "^2.0.3",
    "katex": "^0.18.11",
    "source-map-js": "^1.2.2",
    "handlebars": "^4.7.10",
    "react-cmdk": {
      "react": "$react",
      "react-dom": "$react-dom",
      "@headlessui/react": {
        "react": "$react",
        "react-dom": "$react-dom"
      }
    },
    "deepmerge-ts": "^8.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@smithy/types": "^4.19.0",
    "@tailwindcss/node": "^4.3.4",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "2.12.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "ts-jest": "^29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-svgr": "^5.2.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    }
  }
}
